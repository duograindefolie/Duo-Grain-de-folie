<script>
(function(){
var i=document.getElementById('nom'),o=document.getElementById('out'),j=document.getElementById('jar');
i.addEventListener('input',function(){o.textContent=i.value.trim()||'Votre prénom'});
document.querySelectorAll('.chip').forEach(function(b){b.addEventListener('click',function(){
document.querySelectorAll('.chip').forEach(function(x){x.setAttribute('aria-pressed','false')});
b.setAttribute('aria-pressed','true');j.style.setProperty('--jar',b.dataset.c)})});
})();
