<style>
:root{--bg:#FAF6EF;--surface:#F1E9DC;--card:#FFFDF9;--ink:#2B2826;--muted:#6F6359;--brand:#6E3550;--brand-ink:#fff;--line:#E2D7C6;--wax:#E8D9BC;
--serif:'Fraunces',Georgia,'Times New Roman',serif;--sans:'Figtree',system-ui,-apple-system,'Segoe UI',sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1F1B19;--surface:#2A2522;--card:#2F2926;--ink:#F3EBE0;--muted:#B5A798;--brand:#D9A3BC;--brand-ink:#2B1520;--line:#40372F}}
:root[data-theme="dark"]{--bg:#1F1B19;--surface:#2A2522;--card:#2F2926;--ink:#F3EBE0;--muted:#B5A798;--brand:#D9A3BC;--brand-ink:#2B1520;--line:#40372F}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1rem/1.6 var(--sans);-webkit-font-smoothing:antialiased}
h1,h2,h3{font-family:var(--serif);font-weight:500;line-height:1.15;margin:0;letter-spacing:-.01em}
h1{font-size:clamp(2.1rem,7vw,3.6rem)}h2{font-size:clamp(1.6rem,4.5vw,2.3rem)}h3{font-size:1.15rem}
p{margin:0}a{color:inherit}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}
section{padding:56px 0}
.btn{display:inline-block;background:var(--brand);color:var(--brand-ink);padding:14px 24px;border-radius:999px;font-weight:600;text-decoration:none;border:0;cursor:pointer;font:600 1rem var(--sans)}
.btn.alt{background:transparent;color:var(--ink);border:1.5px solid var(--ink)}
:focus-visible{outline:3px solid var(--brand);outline-offset:3px}
.lead{color:var(--muted);max-width:52ch}
/* header */
.top{background:var(--surface);text-align:center;font-size:.85rem;padding:8px 12px;color:var(--muted)}
header{position:sticky;top:env(safe-area-inset-top,0px);background:var(--bg);border-bottom:1px solid var(--line);z-index:5}
header .wrap{display:flex;align-items:center;justify-content:space-between;height:64px;gap:16px}
.logo{font-family:var(--serif);font-weight:600;font-size:1.25rem;text-decoration:none;display:inline-flex;align-items:center}.logo img{display:block;width:48px;height:48px;border-radius:50%}
nav{display:flex;gap:22px;font-size:.95rem}nav a{text-decoration:none;color:var(--muted)}nav a:hover{color:var(--ink)}
@media(max-width:760px){nav{display:none}}
.cart{font-weight:600;text-decoration:none}
/* hero */
.hero{padding:40px 0 56px}
.hero .wrap{display:grid;gap:36px;align-items:center}
@media(min-width:860px){.hero .wrap{grid-template-columns:1.05fr .95fr}}
.hero p.lead{margin:18px 0 26px;font-size:1.1rem}
.cta{display:flex;flex-wrap:wrap;gap:12px}
.studio{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px}
.studio label{font-weight:600;font-size:.95rem;display:block;margin-bottom:8px}
.studio input[type=text]{width:100%;font:500 1.05rem var(--sans);padding:13px 14px;border-radius:12px;border:1.5px solid var(--line);background:var(--bg);color:var(--ink)}
.chips{display:flex;gap:10px;margin:14px 0 4px}
.chip{width:34px;height:34px;border-radius:50%;border:2px solid var(--line);cursor:pointer;padding:0}
.chip[aria-pressed=true]{outline:3px solid var(--brand);outline-offset:2px}
.preview{display:flex;justify-content:center;align-items:flex-end;height:230px;margin:16px 0;background:var(--surface);border-radius:14px;padding-bottom:26px}
.jar{width:150px;height:140px;border-radius:10px 10px 22px 22px;background:var(--jar,#E8D9BC);position:relative;display:flex;align-items:center;justify-content:center;box-shadow:inset 0 -12px 0 rgba(0,0,0,.06)}
.jar::before{content:"";position:absolute;top:-16px;left:50%;width:3px;height:16px;background:#3b3029;transform:translateX(-50%)}
.jar::after{content:"";position:absolute;top:-30px;left:50%;width:10px;height:16px;background:#F2A63B;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;transform:translateX(-50%)}
.label{background:#FFFDF9;color:#2B2826;border-radius:6px;padding:8px 10px;text-align:center;max-width:116px;font-family:var(--serif);font-size:1rem;line-height:1.2;overflow-wrap:anywhere}
.label small{display:block;font:500 .65rem var(--sans);color:#6F6359;margin-top:3px}
.note{font-size:.85rem;color:var(--muted);margin-top:10px}
/* cards */
.head{display:flex;justify-content:space-between;align-items:end;gap:16px;margin-bottom:28px;flex-wrap:wrap}
.grid{display:grid;gap:16px}
.cats{grid-template-columns:repeat(2,1fr)}@media(min-width:760px){.cats{grid-template-columns:repeat(3,1fr)}}
.cat{text-decoration:none}
.ph{aspect-ratio:4/5;border-radius:14px;background:var(--c,var(--surface));display:flex;align-items:flex-end;padding:12px;font-size:.78rem;color:rgba(43,40,38,.55)}
.cat .ph{aspect-ratio:1/1}
.cat h3,.prod h3{margin:10px 0 2px}
.cat span,.prod p{color:var(--muted);font-size:.9rem}
.prods{grid-template-columns:repeat(2,1fr)}@media(min-width:860px){.prods{grid-template-columns:repeat(4,1fr)}}
.prod{text-decoration:none}
.badge{display:inline-block;background:var(--brand);color:var(--brand-ink);font-size:.72rem;font-weight:600;padding:3px 10px;border-radius:999px;margin-top:6px}
.price{font-weight:600;color:var(--ink)!important}
.band{background:var(--surface)}
.two{display:grid;gap:32px;align-items:center}@media(min-width:860px){.two{grid-template-columns:1fr 1fr}}
.two .ph{aspect-ratio:5/4}
.facts{list-style:none;padding:0;margin:20px 0 26px;display:grid;gap:10px}
.facts li{padding-left:22px;position:relative}.facts li::before{content:"";position:absolute;left:0;top:.6em;width:10px;height:2px;background:var(--brand)}
.occ{display:flex;flex-wrap:wrap;gap:10px}
.occ a{padding:11px 18px;border:1.5px solid var(--line);border-radius:999px;text-decoration:none;background:var(--card);font-weight:500}
.occ a:hover{border-color:var(--brand)}
.quotes{grid-template-columns:1fr}@media(min-width:760px){.quotes{grid-template-columns:repeat(3,1fr)}}
blockquote{margin:0;background:var(--card);border:1px solid var(--line);border-radius:16px;padding:20px}
blockquote footer{margin-top:10px;font-size:.88rem;color:var(--muted)}
.stars{color:#C98A1B;letter-spacing:2px}
.quote-note{font-size:.82rem;color:var(--muted);margin-top:14px}
.devis{background:var(--brand);color:var(--brand-ink);border-radius:24px;padding:40px 24px;text-align:center}
.devis p{margin:12px auto 22px;max-width:46ch;opacity:.92}
.devis .btn{background:var(--brand-ink);color:var(--brand)}
.social{display:flex;flex-wrap:wrap;gap:12px;margin-top:18px}
footer.site{border-top:1px solid var(--line);padding:36px 0 44px;color:var(--muted);font-size:.9rem}
footer.site .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:20px}
footer.site a{margin-right:14px}
.trust{display:flex;flex-wrap:wrap;gap:8px 24px;justify-content:center;font-size:.88rem;color:var(--muted);padding:14px 20px;border-bottom:1px solid var(--line)}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}}
</style>
</head>
