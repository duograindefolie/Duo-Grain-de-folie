<button class="chip" style="background:#C9D3BC" aria-pressed="false" aria-label="Sauge" data-c="#C9D3BC"></button>
<button class="chip" style="background:#E5B9B0" aria-pressed="false" aria-label="Rose poudré" data-c="#E5B9B0"></button>
<button class="chip" style="background:#B9A07F" aria-pressed="false" aria-label="Caramel" data-c="#B9A07F"></button>
</div>
<div class="preview" aria-live="polite"><div class="jar" id="jar"><div class="label"><span id="out">Adeline</span><small>cire végétale · coulée à la main</small></div></div></div>
